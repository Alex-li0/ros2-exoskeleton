<ros2_control name="ExoskeletonSystem" type="system">

    <hardware>
      <plugin>exoskeleton_hardware/ExoHardwareInterface</plugin>
      <param name="serial_port">auto</param>
      <param name="baud_rate">115200</param>
      <param name="read_only">$(arg read_only)</param>
      <!-- 4 电机 (2 CAN × 2), 减速比 36:1, 16bit 编码器 -->
      <param name="reduction_ratio">36.0</param>
      <!-- 硬件层力矩安全上限 [iq], 实际限幅取 min(此值, 控制器 yaml torque_limit)
           控制器 yaml 现为 80 → 生效上限 = 80; 此值只作硬件安全兜底 -->
      <param name="torque_limit">200.0</param>
      <param name="current_limit">20.0</param>
      <!-- 踝角速度由上位机差分后一阶低通；(0,1]，越小滤波越强 -->
      <param name="ankle_velocity_filter_alpha">0.2</param>
      <!-- 真机测试: false 打开串口; 无硬件调试时改回 true 跳过串口 -->
      <param name="use_mock">false</param>
      <!-- 关节↔电机映射在 exo_controllers.yaml 的 joint_motor_map 段
           修改该 yaml 后重启 launch 生效, 无需重新编译 -->
      <param name="motor_map_file">/home/lsy/vins_ws/src/exoskeleton_hardware/config/exo_controllers.yaml</param>
    </hardware>

    <!-- 左腿 2 个主动关节 -->
    <joint name="left_hip3">
      <command_interface name="effort"/>
      <command_interface name="zero_position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>  <!-- 电机 iq 电流 -->
      <state_interface name="temperature"/>
      <state_interface name="error_state"/>
      <state_interface name="feedback_age_ms"/>
      <state_interface name="feedback_valid"/>
      <state_interface name="stm32_tick_ms"/>
      <state_interface name="feedback_sequence"/>
    </joint>

    <joint name="left_knee">
      <command_interface name="effort"/>
      <command_interface name="zero_position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
      <state_interface name="error_state"/>
      <state_interface name="feedback_age_ms"/>
      <state_interface name="feedback_valid"/>
      <state_interface name="stm32_tick_ms"/>
      <state_interface name="feedback_sequence"/>
    </joint>

    <!-- 右腿 2 个主动关节 -->
    <joint name="right_hip3">
      <command_interface name="effort"/>
      <command_interface name="zero_position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
      <state_interface name="error_state"/>
      <state_interface name="feedback_age_ms"/>
      <state_interface name="feedback_valid"/>
      <state_interface name="stm32_tick_ms"/>
      <state_interface name="feedback_sequence"/>
    </joint>

    <joint name="right_knee">
      <command_interface name="effort"/>
      <command_interface name="zero_position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
      <state_interface name="error_state"/>
      <state_interface name="feedback_age_ms"/>
      <state_interface name="feedback_valid"/>
      <state_interface name="stm32_tick_ms"/>
      <state_interface name="feedback_sequence"/>
    </joint>

    <!-- 被动踝关节只导出状态，无 command interface，不会使能或施加力矩。 -->
    <sensor name="left_ankle">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="raw_count"/>
      <state_interface name="node_id"/>
      <state_interface name="feedback_valid"/>
      <state_interface name="stale"/>
    </sensor>

    <sensor name="right_ankle">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="raw_count"/>
      <state_interface name="node_id"/>
      <state_interface name="feedback_valid"/>
      <state_interface name="stale"/>
    </sensor>

  </ros2_control>
</robot>
